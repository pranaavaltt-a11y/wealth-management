digraph R {
  graph [rankdir=RL nodesep=0.35 ranksep=0.9 fontname="Helvetica"];
  node [shape=plaintext fontname="Helvetica" fontsize=11];
  edge [color="#555555" arrowsize=0.7];
  HOSTEL [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#1f4e79"><FONT COLOR="white"><B>HOSTEL</B></FONT></TD></TR><TR><TD PORT="Hostel_ID" ALIGN="LEFT"><U>Hostel_ID</U></TD></TR><TR><TD PORT="Hostel_Name" ALIGN="LEFT">Hostel_Name</TD></TR><TR><TD PORT="Location" ALIGN="LEFT">Location</TD></TR><TR><TD PORT="Capacity" ALIGN="LEFT">Capacity</TD></TR></TABLE>>];
  STAFF [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#1f4e79"><FONT COLOR="white"><B>STAFF</B></FONT></TD></TR><TR><TD PORT="Staff_ID" ALIGN="LEFT"><U>Staff_ID</U></TD></TR><TR><TD PORT="Name" ALIGN="LEFT">Name</TD></TR><TR><TD PORT="Salary" ALIGN="LEFT">Salary</TD></TR><TR><TD PORT="Designation" ALIGN="LEFT">Designation</TD></TR><TR><TD PORT="Hostel_ID" ALIGN="LEFT">Hostel_ID <FONT COLOR="#b03030">(FK)</FONT></TD></TR><TR><TD PORT="Supervisor_ID" ALIGN="LEFT">Supervisor_ID <FONT COLOR="#b03030">(FK)</FONT></TD></TR></TABLE>>];
  ROOM [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#1f4e79"><FONT COLOR="white"><B>ROOM</B></FONT></TD></TR><TR><TD PORT="Hostel_ID" ALIGN="LEFT"><U>Hostel_ID</U> <FONT COLOR="#b03030">(FK)</FONT></TD></TR><TR><TD PORT="Room_Number" ALIGN="LEFT"><U>Room_Number</U></TD></TR><TR><TD PORT="Floor" ALIGN="LEFT">Floor</TD></TR></TABLE>>];
  ROOM_BED [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#1f4e79"><FONT COLOR="white"><B>ROOM_BED</B></FONT></TD></TR><TR><TD PORT="Hostel_ID" ALIGN="LEFT"><U>Hostel_ID</U> <FONT COLOR="#b03030">(FK)</FONT></TD></TR><TR><TD PORT="Room_Number" ALIGN="LEFT"><U>Room_Number</U> <FONT COLOR="#b03030">(FK)</FONT></TD></TR><TR><TD PORT="Bed_Number" ALIGN="LEFT"><U>Bed_Number</U></TD></TR><TR><TD PORT="Availability" ALIGN="LEFT">Availability</TD></TR></TABLE>>];
  STUDENT [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#1f4e79"><FONT COLOR="white"><B>STUDENT</B></FONT></TD></TR><TR><TD PORT="Student_ID" ALIGN="LEFT"><U>Student_ID</U></TD></TR><TR><TD PORT="First_Name" ALIGN="LEFT">First_Name</TD></TR><TR><TD PORT="Middle_Name" ALIGN="LEFT">Middle_Name</TD></TR><TR><TD PORT="Last_Name" ALIGN="LEFT">Last_Name</TD></TR><TR><TD PORT="Gender" ALIGN="LEFT">Gender</TD></TR><TR><TD PORT="Date_of_Birth" ALIGN="LEFT">Date_of_Birth</TD></TR><TR><TD PORT="Email_Address" ALIGN="LEFT">Email_Address</TD></TR></TABLE>>];
  STUDENT_PHONE [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#1f4e79"><FONT COLOR="white"><B>STUDENT_PHONE</B></FONT></TD></TR><TR><TD PORT="Student_ID" ALIGN="LEFT"><U>Student_ID</U> <FONT COLOR="#b03030">(FK)</FONT></TD></TR><TR><TD PORT="Phone_Number" ALIGN="LEFT"><U>Phone_Number</U></TD></TR></TABLE>>];
  ALLOCATION [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#1f4e79"><FONT COLOR="white"><B>ALLOCATION</B></FONT></TD></TR><TR><TD PORT="Student_ID" ALIGN="LEFT"><U>Student_ID</U> <FONT COLOR="#b03030">(FK)</FONT></TD></TR><TR><TD PORT="Hostel_ID" ALIGN="LEFT"><U>Hostel_ID</U> <FONT COLOR="#b03030">(FK)</FONT></TD></TR><TR><TD PORT="Room_Number" ALIGN="LEFT"><U>Room_Number</U> <FONT COLOR="#b03030">(FK)</FONT></TD></TR><TR><TD PORT="Allocation_Date" ALIGN="LEFT">Allocation_Date</TD></TR><TR><TD PORT="Check_in_Date" ALIGN="LEFT">Check_in_Date</TD></TR><TR><TD PORT="Check_out_Date" ALIGN="LEFT">Check_out_Date</TD></TR></TABLE>>];
  PAYMENT [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#1f4e79"><FONT COLOR="white"><B>PAYMENT</B></FONT></TD></TR><TR><TD PORT="Payment_ID" ALIGN="LEFT"><U>Payment_ID</U></TD></TR><TR><TD PORT="Payment_Date" ALIGN="LEFT">Payment_Date</TD></TR><TR><TD PORT="Amount" ALIGN="LEFT">Amount</TD></TR><TR><TD PORT="Payment_Type" ALIGN="LEFT">Payment_Type</TD></TR><TR><TD PORT="Student_ID" ALIGN="LEFT">Student_ID <FONT COLOR="#b03030">(FK)</FONT></TD></TR></TABLE>>];
  RECEIPT [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#1f4e79"><FONT COLOR="white"><B>RECEIPT</B></FONT></TD></TR><TR><TD PORT="Receipt_ID" ALIGN="LEFT"><U>Receipt_ID</U></TD></TR><TR><TD PORT="Receipt_Date" ALIGN="LEFT">Receipt_Date</TD></TR><TR><TD PORT="Payment_ID" ALIGN="LEFT">Payment_ID <FONT COLOR="#b03030">(FK)</FONT></TD></TR></TABLE>>];
  FACILITY [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#1f4e79"><FONT COLOR="white"><B>FACILITY</B></FONT></TD></TR><TR><TD PORT="Facility_ID" ALIGN="LEFT"><U>Facility_ID</U></TD></TR><TR><TD PORT="Facility_Name" ALIGN="LEFT">Facility_Name</TD></TR><TR><TD PORT="Operating_Hours" ALIGN="LEFT">Operating_Hours</TD></TR><TR><TD PORT="Hostel_ID" ALIGN="LEFT">Hostel_ID <FONT COLOR="#b03030">(FK)</FONT></TD></TR></TABLE>>];
  FACILITY_USAGE [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#1f4e79"><FONT COLOR="white"><B>FACILITY_USAGE</B></FONT></TD></TR><TR><TD PORT="Student_ID" ALIGN="LEFT"><U>Student_ID</U> <FONT COLOR="#b03030">(FK)</FONT></TD></TR><TR><TD PORT="Facility_ID" ALIGN="LEFT"><U>Facility_ID</U> <FONT COLOR="#b03030">(FK)</FONT></TD></TR></TABLE>>];
  STAFF:Hostel_ID -> HOSTEL:Hostel_ID;
  STAFF:Supervisor_ID -> STAFF:Staff_ID;
  ROOM:Hostel_ID -> HOSTEL:Hostel_ID;
  ROOM_BED:Room_Number -> ROOM:Room_Number;
  STUDENT_PHONE:Student_ID -> STUDENT:Student_ID;
  ALLOCATION:Student_ID -> STUDENT:Student_ID;
  ALLOCATION:Room_Number -> ROOM:Room_Number;
  PAYMENT:Student_ID -> STUDENT:Student_ID;
  RECEIPT:Payment_ID -> PAYMENT:Payment_ID;
  FACILITY:Hostel_ID -> HOSTEL:Hostel_ID;
  FACILITY_USAGE:Student_ID -> STUDENT:Student_ID;
  FACILITY_USAGE:Facility_ID -> FACILITY:Facility_ID;
}