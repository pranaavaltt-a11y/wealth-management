{
 "uid": "igr-main",
 "title": "Grievance Routing \u2014 service and agents",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Complete run latency p50 / p95 (submission to result)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.50, sum(rate(igr_run_seconds_bucket[1m])) by (le))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum(rate(igr_run_seconds_bucket[1m])) by (le))",
     "legendFormat": "p95"
    },
    {
     "refId": "C",
     "expr": "20",
     "legendFormat": "SLO p95 target"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Throughput (finished runs / s)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(igr_runs_finished_total[1m]))",
     "legendFormat": "runs/s"
    },
    {
     "refId": "B",
     "expr": "sum(rate(igr_runs_submitted_total[1m]))",
     "legendFormat": "submitted/s"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Error rate",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(igr_runs_finished_total{outcome=\"failed\"}[5m])) / clamp_min(sum(rate(igr_runs_finished_total[5m])), 1e-9)",
     "legendFormat": "failed runs"
    },
    {
     "refId": "B",
     "expr": "sum(rate(igr_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(igr_http_requests_total[5m])), 1e-9)",
     "legendFormat": "HTTP 5xx"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Availability (targets up)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "avg by (job) (up)",
     "legendFormat": "{{job}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Queue depth",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 8,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(igr_queue_depth)",
     "legendFormat": "waiting runs"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "CPU per container",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\".+\"}[1m]))",
     "legendFormat": "{{name}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Memory per container",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (name) (container_memory_working_set_bytes{name=~\".+\"})",
     "legendFormat": "{{name}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Task success rate per agent",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (agent) (rate(igr_agent_tasks_total{outcome=~\"ok|verified|pass\"}[5m])) / sum by (agent) (rate(igr_agent_tasks_total[5m]))",
     "legendFormat": "{{agent}}"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Steps and tool calls per run",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(igr_agent_steps_per_run_sum[5m])) / sum(rate(igr_agent_steps_per_run_count[5m]))",
     "legendFormat": "steps/run"
    },
    {
     "refId": "B",
     "expr": "sum(rate(igr_agent_tool_calls_per_run_sum[5m])) / sum(rate(igr_agent_tool_calls_per_run_count[5m]))",
     "legendFormat": "tool calls/run"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Model retry rate per agent",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (agent) (rate(igr_llm_retries_total[5m])) / clamp_min(sum by (agent) (rate(igr_llm_calls_total[5m])), 1e-9)",
     "legendFormat": "{{agent}}"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Per-step latency p95",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, agent, step) (rate(igr_agent_step_seconds_bucket[5m])))",
     "legendFormat": "{{agent}} {{step}}"
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Container / process uptime",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - process_start_time_seconds",
     "legendFormat": "{{job}} {{instance}}"
    }
   ]
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Circuit breaker open",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 40,
    "w": 6,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (instance) (igr_circuit_breaker_open)",
     "legendFormat": "{{instance}}"
    }
   ]
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Cost per run (USD)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 40,
    "w": 6,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(igr_llm_cost_usd_total[5m])) / clamp_min(sum(rate(igr_runs_finished_total[5m])), 1e-9)",
     "legendFormat": "cost/run"
    }
   ]
  },
  {
   "id": 15,
   "type": "timeseries",
   "title": "Tokens / s by agent",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 40,
    "w": 6,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (agent, kind) (rate(igr_llm_tokens_total[5m]))",
     "legendFormat": "{{agent}} {{kind}}"
    }
   ]
  },
  {
   "id": 16,
   "type": "timeseries",
   "title": "Cache hit ratio",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 40,
    "w": 6,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (cache) (rate(igr_cache_total{result=\"hit\"}[5m])) / sum by (cache) (rate(igr_cache_total[5m]))",
     "legendFormat": "{{cache}}"
    }
   ]
  },
  {
   "id": 17,
   "type": "timeseries",
   "title": "Online quality of sampled live runs",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 48,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (metric) (rate(igr_online_quality_sum[15m])) / sum by (metric) (rate(igr_online_quality_count[15m]))",
     "legendFormat": "{{metric}}"
    }
   ]
  },
  {
   "id": 18,
   "type": "timeseries",
   "title": "Guardrails, quarantine and rate limiting",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 48,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (guard, action) (increase(igr_guardrail_events_total[15m]))",
     "legendFormat": "{{guard}} {{action}}"
    },
    {
     "refId": "B",
     "expr": "sum(increase(igr_quarantined_total[15m]))",
     "legendFormat": "quarantined"
    },
    {
     "refId": "C",
     "expr": "sum(increase(igr_rate_limited_total[15m]))",
     "legendFormat": "rate limited"
    }
   ]
  },
  {
   "id": 19,
   "type": "timeseries",
   "title": "Index freshness (age) and size",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 56,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - max(igr_index_built_timestamp_seconds)",
     "legendFormat": "index age"
    },
    {
     "refId": "B",
     "expr": "max(igr_index_chunks)",
     "legendFormat": "chunks"
    }
   ]
  },
  {
   "id": 20,
   "type": "timeseries",
   "title": "Run outcomes",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 56,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (outcome, route, degraded) (increase(igr_runs_finished_total[15m]))",
     "legendFormat": "{{outcome}} {{route}} degraded={{degraded}}"
