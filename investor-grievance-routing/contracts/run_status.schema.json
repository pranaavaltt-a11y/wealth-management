      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latency S"
    },
    "notice": {
      "default": "Advisory routing determination only. A grievance officer decides; the system never disposes of a complaint.",
      "title": "Notice",
      "type": "string"
    }
