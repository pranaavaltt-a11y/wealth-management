# Copy to .env and edit. Every value is optional: with no .env the system runs against the bundled stub model.
# Nothing in the repository holds credentials, provider endpoints or model identifiers. They are set here.

# --- Model provider (any OpenAI-compatible chat-completions endpoint) ---
# Leave LLM_BASE_URL unset to use the bundled stub (service llm-stub).
# Examples of what goes here: your provider's OpenAI-compatible base URL, ending in /v1.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE_S=0.5
# Circuit breaker: open after N consecutive failed calls, try again after the cool-down
CB_FAILURE_THRESHOLD=4
CB_RESET_AFTER_S=30
# Prices used to record cost at call time (USD per million tokens). 0 for a free tier.
LLM_PRICE_INPUT_PER_MTOK_USD=0
LLM_PRICE_OUTPUT_PER_MTOK_USD=0

# --- Embeddings ---
# hash: offline, dependency-free (default). sentence-transformers: set EMBEDDING_MODEL and build with
# INSTALL_SENTENCE_TRANSFORMERS=true, then: docker compose run --rm indexer python -m app.retrieval.ingest --force
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL=
INSTALL_SENTENCE_TRANSFORMERS=false
CHUNKING=clause

# --- Agent loop bounds ---
AGENT_MAX_STEPS=12
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_WALL_S=90
TOOL_TIMEOUT_S=5
MAX_VERIFY_ATTEMPTS=2
PROMPT_VARIANT=v2

# --- API ---
RATE_LIMIT_PER_MIN=30
RUN_CACHE_ENABLED=true
RUN_CACHE_TTL_S=86400
RETRIEVAL_CACHE_ENABLED=true
# Enables options.demo_fault in requests (demonstration item 6). Keep false outside demos.
DEMO_FAULTS_ENABLED=false
ONLINE_EVAL_SAMPLE_RATE=0.2
WORKER_CONCURRENCY=1

# --- Stub provider used for load tests ---
STUB_DELAY_MEAN_MS=900
STUB_DELAY_JITTER_MS=300

# --- Observability ---
LOG_LEVEL=INFO
GRAFANA_ADMIN_PASSWORD=change-me
