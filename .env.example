# ---- PostgreSQL (relational core) ----
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/arthatrack

# ---- MongoDB (documents, raw imports, valuation history, news cache) ----
# App degrades gracefully (Mongo-backed features disabled) if this is unset.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=arthatrack

# ---- Auth ----
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
