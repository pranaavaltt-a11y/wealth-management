{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "target": "ES2022"
  },
  "include": ["src/**/*.js", "src/**/*.jsx", "scripts/**/*.js", "tests/**/*.js"],
  "exclude": ["node_modules", ".next"]
}
