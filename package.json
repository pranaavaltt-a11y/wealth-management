{
  "name": "wealthwise",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "tsx --tsconfig jsconfig.json scripts/migrate.js",
    "db:seed": "tsx --tsconfig jsconfig.json scripts/seed.js",
    "db:reset": "tsx --tsconfig jsconfig.json scripts/migrate.js --reset && tsx --tsconfig jsconfig.json scripts/seed.js",
    "test": "npm run test:unit && npm run test:db",
    "test:unit": "tsx --tsconfig jsconfig.json --test \"tests/unit/**/*.test.js\"",
    "test:db": "tsx --tsconfig jsconfig.json scripts/test-db.js && tsx --tsconfig jsconfig.json --test --test-concurrency=1 \"tests/db/**/*.test.js\"",
    "docs:generate": "tsx --tsconfig jsconfig.json scripts/generate-docs.js"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "mongodb": "^6.10.0",
    "next": "^14.2.18",
    "pdfkit": "^0.15.2",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "tesseract.js": "^7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@hpcc-js/wasm-graphviz": "^1.29.2",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2"
  }
}
