// WealthWise — conceptual ER diagram, Chen notation.
//   rectangle            entity            double rectangle  weak entity
//   diamond              relationship      double diamond    identifying relationship
//   ellipse              attribute         underlined        key attribute
//   dashed ellipse       derived attribute
//   1 / N on an edge     cardinality;  double line = total participation
graph wealthwise_er {
  graph [layout=neato, overlap=false, splines=true, sep="+14", outputorder=edgesfirst,
         fontname="DejaVu Sans", bgcolor="white", pad=0.3];
  node  [fontname="DejaVu Sans", fontsize=11, color="#3a3733", fontcolor="#3a3733", penwidth=1.2];
  edge  [fontname="DejaVu Sans", fontsize=10, color="#6b655c", fontcolor="#b0663a"];

  // ---------------------------------------------------------------- entities
  node [shape=box, style="filled", fillcolor="#f2eee6", height=0.5, width=1.5];
  USER [label="USER", pos="0,0!"];
  ASSET [label="ASSET", pos="-5.6,0!"];
  LOAN [label="LOAN", pos="5.6,0!"];
  TXN [label="TRANSACTION", pos="0,-4.4!"];
  RULE [label="CATEGORIZATION\nRULE", pos="-3,4.6!"];
  PREPAY [label="LOAN\nPREPAYMENT", pos="5.6,4.6!"];
  PRODUCT [label="LOAN PRODUCT\n(reference data)", pos="9.6,4.6!"];

  node [peripheries=2];
  SNAP [label="NET WORTH\nSNAPSHOT", pos="-5.6,-4.4!"];
  SCORE [label="CREDIT\nSCORE", pos="1.6,4.6!"];
  EMI [label="EMI\nINSTALLMENT", pos="5.6,-4.4!"];
  NOTE [label="NOTIFICATION", pos="3.4,-6.7!", peripheries=1];

  // ----------------------------------------------------------- relationships
  node [shape=diamond, style="filled", fillcolor="#fbf9f5", width=1.25, height=0.75, peripheries=1, fontsize=10];
  OWNS [label="owns", pos="-2.8,0!"];
  BORROWS [label="borrows", pos="2.8,0!"];
  RECORDS [label="records", pos="0,-2.2!"];
  ADVISES [label="advises", pos="-2.3,1.6!"];
  DEFINES [label="defines", pos="-1.6,2.6!"];
  FUNDS [label="funds", pos="-2.8,-2.4!"];
  SETTLES [label="settles", pos="2.8,-2.4!"];
  PREPAID [label="prepaid\nby", pos="5.6,2.3!"];
  ABOUT [label="about", pos="4.7,-5.7!"];
  RECEIVES [label="receives", pos="2.1,-4.3!"];
  REPAID [label="repaid\nby", pos="5.6,-2.2!", peripheries=2];
  VALUED [label="valued\nas", pos="-5.6,-2.2!", peripheries=2];
  SCORED [label="scored\nas", pos="0.8,2.6!", peripheries=2];

  // ----------------------------------------------------------- attributes
  node [shape=ellipse, style="", width=0.9, height=0.42, fontsize=9.5, color="#948d82"];
  u_id [label=<<u>user_id</u>>, pos="-0.9,-1!"];
  u_email [label="email (unique)", pos="1.1,-1!"];
  u_role [label="role", pos="1.3,0.9!"];
  u_pan [label="pan_number", pos="-1.5,-1.3!"];

  a_id [label=<<u>asset_id</u>>, pos="-7.3,0.8!"];
  a_type [label="asset_type", pos="-7.4,-0.5!"];
  a_val [label="current_value", pos="-6.1,1.3!"];
  a_liq [label="liquidity", pos="-4.4,1.1!"];

  l_id [label=<<u>loan_id</u>>, pos="7.4,0.8!"];
  l_rate [label="interest_rate", pos="7.6,-0.4!"];
  l_type [label="interest_type", pos="6.5,1.4!"];
  l_out [label="outstanding", style=dashed, pos="4.2,1.3!"];

  e_no [label=<<u>installment_no</u>>, style=dashed, pos="7.4,-5.5!"];
  e_due [label="due_date", pos="7.7,-3.5!"];
  e_split [label="principal /\ninterest", pos="6.4,-6!"];

  t_id [label=<<u>txn_id</u>>, pos="-1.4,-5.6!"];
  t_type [label="txn_type", pos="1.4,-5.6!"];
  t_hash [label="import_hash", pos="0,-6.3!"];

  s_date [label=<<u>snapshot_date</u>>, style=dashed, pos="-7.4,-5.4!"];
  s_nw [label="net_worth", style=dashed, pos="-4.6,-5.6!"];

  c_date [label=<<u>computed_date</u>>, style=dashed, pos="2.2,6!"];
  c_score [label="score 300–900", pos="0.4,6!"];

  r_kw [label="keyword", pos="-4.6,5.8!"];
  r_pri [label="priority", pos="-1.6,5.8!"];

  p_amt [label="amount", pos="4.4,5.8!"];
  p_mode [label="mode", pos="6.8,5.8!"];

  pr_band [label="rate band", pos="8.6,6!"];
  pr_min [label="min_credit_score", pos="10.8,6!"];

  // ----------------------------------------------------------- edges
  // 1:N with total participation on the N side (every asset has an owner).
  USER -- OWNS [label="1"];          OWNS -- ASSET [label="N", penwidth=2.6];
  USER -- BORROWS [label="1"];       BORROWS -- LOAN [label="N", penwidth=2.6];
  USER -- RECORDS [label="1"];       RECORDS -- TXN [label="N", penwidth=2.6];
  USER -- DEFINES [label="0..1"];    DEFINES -- RULE [label="N"];
  // Recursive: an advisor (role = advisor) advises many individual users.
  USER:nw -- ADVISES:e [label="advisor 1"];  ADVISES:s -- USER:w [label="client N"];
  ASSET -- FUNDS [label="0..1"];     FUNDS -- TXN [label="N"];
  LOAN -- SETTLES [label="0..1"];    SETTLES -- TXN [label="N"];
  LOAN -- PREPAID [label="1"];       PREPAID -- PREPAY [label="N", penwidth=2.6];
  USER -- RECEIVES [label="1"];      RECEIVES -- NOTE [label="N", penwidth=2.6];
  EMI -- ABOUT [label="0..1"];       ABOUT -- NOTE [label="N"];
  // Identifying relationships: the weak entity has no key of its own.
  LOAN -- REPAID [label="1"];        REPAID -- EMI [label="N", penwidth=2.6];
  USER -- VALUED [label="1"];        VALUED -- SNAP [label="N", penwidth=2.6];
  USER -- SCORED [label="1"];        SCORED -- SCORE [label="N", penwidth=2.6];

  edge [color="#948d82", fontcolor="#948d82", label=""];
  USER -- {u_id u_email u_role u_pan};
  ASSET -- {a_id a_type a_val a_liq};
  LOAN -- {l_id l_rate l_type l_out};
  EMI -- {e_no e_due e_split};
  TXN -- {t_id t_type t_hash};
  SNAP -- {s_date s_nw};
  SCORE -- {c_date c_score};
  RULE -- {r_kw r_pri};
  PREPAY -- {p_amt p_mode};
  PRODUCT -- {pr_band pr_min};
}
